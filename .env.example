# System Configuration
NODE_ENV=development
PORT=5000

# Default Seed User Credentials
DEFAULT_ADMIN_PASSWORD=your_admin_seed_password
DEFAULT_AGENT_PASSWORD=your_agent_seed_password

# Database Connections
MONGODB_URI=mongodb://localhost:27017/customer_support_crm
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Exotel Telephony Credentials
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_WEBHOOK_SECRET=your_exotel_webhook_secret

# OpenAI Realtime API Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01
OPENAI_VOICE=alloy

# Client URL (React SPA)
CLIENT_URL=http://localhost:5173

# Provider Abstraction Flags (mock | exotel | openai | s3 | socket)
CALL_PROVIDER=mock
AI_PROVIDER=mock
RECORDING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

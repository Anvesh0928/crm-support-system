# Production Environment Template
NODE_ENV=production
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost

# Database Connections (Docker Internal Network)
MONGODB_URI=mongodb://mongodb:27017/customer_support_crm
REDIS_HOST=redis
REDIS_PORT=6379

# Security Secrets
JWT_SECRET=super_secret_production_jwt_key_change_me_in_prod_12345
JWT_EXPIRES_IN=7d

# Exotel Telephony Credentials
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VIRTUAL_NUMBER=08045678901
EXOTEL_WEBHOOK_SECRET=your_exotel_webhook_hmac_secret

# OpenAI Realtime API Config
OPENAI_API_KEY=sk-proj-your_real_openai_api_key
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01
OPENAI_VOICE=alloy
